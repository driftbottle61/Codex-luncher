#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${CODEX_PROVIDER_ROOT:-/root/.codex-providers}"
CODEX="$(command -v codex)"
die() { printf 'codex-provider: %s\n' "$*" >&2; exit 1; }
valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
provider_dir() { printf '%s/%s' "$ROOT" "$1"; }

update_provider_models() {
    local pname="$1" dir keyvar tmp
    dir="$(provider_dir "$pname")"
    [ -f "$dir/provider.conf" ] || die "unknown provider: $pname"
    unset name label base_url model wire_api key_env
    . "$dir/provider.conf"
    keyvar="$key_env"
    if [ -z "${!keyvar:-}" ] && [ -f "$dir/api-key" ]; then export "$keyvar=$(<"$dir/api-key")"; fi
    [ -n "${!keyvar:-}" ] || die "environment variable $keyvar is not set and no saved key exists"
    command -v curl >/dev/null 2>&1 || die 'curl is required to update models'
    command -v jq >/dev/null 2>&1 || die 'jq is required to update models'
    tmp="$(mktemp)"
    if ! curl -fsSL --max-time 30 -H "Authorization: Bearer ${!keyvar}" "$base_url/models" -o "$tmp"; then rm -f "$tmp"; return 1; fi
    jq -e '{models: [(.data // .models // [])[] | (.id // .slug) as $id | select($id != null) | {slug:$id,id:$id,display_name:(.name // $id)}]}' "$tmp" > "$dir/model-catalog.json" || { rm -f "$tmp"; return 1; }
    chmod 600 "$dir/model-catalog.json"; rm -f "$tmp"; printf 'Updated model catalog: %s\n' "$dir/model-catalog.json"
}

auto_update_models() {
    local dir
    [ "${CODEX_PROVIDER_AUTO_UPDATE:-0}" = 1 ] || return 0
    for dir in "$ROOT"/*; do [ -f "$dir/provider.conf" ] || continue; unset name; . "$dir/provider.conf"; update_provider_models "$name" || true; done
}

ensure_base_instructions() {
    local out="$ROOT/base-instructions.md" ver tag url
    [ -s "$out" ] && { printf '%s' "$out"; return 0; }
    ver="$(codex --version 2>/dev/null | sed -n 's/^codex-cli \([0-9][0-9.]*\).*/\1/p' | head -1 || true)"
    tag="main"
    [ -n "$ver" ] && tag="rust-v$ver"
    command -v curl >/dev/null 2>&1 || { printf '%s' ''; return 0; }
    url="https://raw.githubusercontent.com/openai/codex/$tag/codex-rs/models-manager/prompt.md"
    if curl -fsSL --max-time 20 "$url" -o "$out.tmp" 2>/dev/null && [ -s "$out.tmp" ]; then
        mv "$out.tmp" "$out"; chmod 644 "$out"; printf '%s' "$out"; return 0
    fi
    rm -f "$out.tmp"
    if [ "$tag" != main ]; then
        url="https://raw.githubusercontent.com/openai/codex/main/codex-rs/models-manager/prompt.md"
        if curl -fsSL --max-time 20 "$url" -o "$out.tmp" 2>/dev/null && [ -s "$out.tmp" ]; then
            mv "$out.tmp" "$out"; chmod 644 "$out"; printf '%s' "$out"; return 0
        fi
        rm -f "$out.tmp"
    fi
    printf '%s' ''
}

ensure_codex_catalog() {
    local dir="$1" base
    [ -f "$dir/model-catalog.json" ] || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    base="$(ensure_base_instructions)"
    python3 - "$dir" "${base:-}" <<'PY'
import json, os, sys
dirpath, base_path = sys.argv[1], sys.argv[2] or None
src = json.load(open(os.path.join(dirpath, "model-catalog.json")))
instructions = "You are a helpful coding assistant."
if base_path and os.path.isfile(base_path):
    with open(base_path, encoding="utf-8") as f:
        content = f.read().strip()
    if content:
        instructions = content
models = []
for item in src.get("models", []):
    slug = item.get("slug") or item.get("id")
    if not slug:
        continue
    models.append({
        "slug": slug,
        "display_name": item.get("display_name") or slug,
        "description": item.get("description"),
        "default_reasoning_level": "low",
        "supported_reasoning_levels": [
            {"effort": "low", "description": "Fast responses with lighter reasoning"},
            {"effort": "medium", "description": "Balances speed and reasoning depth for everyday tasks"},
            {"effort": "high", "description": "Greater reasoning depth for complex problems"},
        ],
        "shell_type": "unified_exec",
        "visibility": "list",
        "supported_in_api": True,
        "priority": 10,
        "availability_nux": None,
        "upgrade": None,
        "default_reasoning_summary": "auto",
        "support_verbosity": False,
        "default_verbosity": None,
        "apply_patch_tool_type": None,
        "web_search_tool_type": "text",
        "truncation_policy": {"mode": "tokens", "limit": 10000},
        "supports_image_detail_original": False,
        "context_window": 272000,
        "max_context_window": 272000,
        "auto_compact_token_limit": None,
        "comp_hash": None,
        "effective_context_window_percent": 95,
        "experimental_supported_tools": [],
        "input_modalities": ["text"],
        "supports_search_tool": False,
        "use_responses_lite": False,
        "node_repl_auto_review_required": False,
        "node_repl_disabled": False,
        "auto_review_model_override": None,
        "model_specialty": None,
        "tool_mode": None,
        "multi_agent_version": None,
        "multi_agent_reasoning_effort": None,
        "model_messages": {
            "persistent_instructions": None,
            "tools": None,
            "instructions_template": instructions,
            "instructions_variables": None,
            "approvals": None,
            "collaboration_modes": None,
            "auto_review": None,
            "permissions": None,
            "multi_agent": None,
            "token_budget": None,
            "confirmation_policies": None,
            "guardian_v2": None,
        },
    })
if not models:
    sys.exit(1)
out = os.path.join(dirpath, "model-catalog-codex.json")
tmp = out + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump({"models": models}, f, indent=2, ensure_ascii=False)
os.replace(tmp, out)
os.chmod(out, 0o600)
PY
}

setup_provider() {
    local name label base model wire keyvar key catalog dir
    read -r -p 'Provider name: ' name
    valid_name "$name" || die 'invalid provider name'
    dir="$(provider_dir "$name")"
    read -r -p "Display name [$name]: " label; label="${label:-$name}"
    read -r -p 'API base URL: ' base
    [[ "$base" =~ ^https?:// ]] || die 'API base URL must start with http:// or https://'
    read -r -p 'Model: ' model; [ -n "$model" ] || die 'model is required'
    read -r -p 'Wire API [responses]: ' wire; wire="${wire:-responses}"
    read -r -p 'Model catalog JSON path or URL (optional): ' catalog
    read -r -p 'API key environment variable [OPENAI_API_KEY]: ' keyvar; keyvar="${keyvar:-OPENAI_API_KEY}"
    [[ "$keyvar" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die 'invalid environment variable name'
    read -r -s -p 'API key (hidden input): ' key; printf '\n'
    [ -n "$key" ] || die 'API key is required'
    mkdir -p "$dir/sessions"; chmod 700 "$ROOT" "$dir" "$dir/sessions"
    cat > "$dir/provider.conf" <<EOF
name=$name
label=$label
base_url=$base
model=$model
wire_api=$wire
key_env=$keyvar
EOF
    chmod 600 "$dir/provider.conf"
    printf '%s\n' "$key" > "$dir/api-key"
    chmod 600 "$dir/api-key"
    if [ -n "$catalog" ]; then
        case "$catalog" in
            https://*|http://*) command -v curl >/dev/null 2>&1 || die 'curl is required for catalog URL'; curl -fsSL --max-time 30 "$catalog" -o "$dir/model-catalog.json" ;;
            *) [ -f "$catalog" ] || die "catalog file not found: $catalog"; cp "$catalog" "$dir/model-catalog.json" ;;
        esac
        chmod 600 "$dir/model-catalog.json"
    fi
    printf 'Configured %s. Export %s before use.\n' "$name" "$keyvar"
}

list_providers() {
    [ -d "$ROOT" ] || { echo 'No providers configured.'; return; }
    for dir in "$ROOT"/*; do
        [ -f "$dir/provider.conf" ] || continue
        unset name label base_url model wire_api key_env
        . "$dir/provider.conf"
        printf '%-18s model=%-28s key=%s sessions=%s\n' "$name" "$model" "$key_env" "$dir/sessions"
    done
}

choose_provider() {
    local dir name sel h idx action
    local -a dirs=() items=() homes=()
    [ -d "$ROOT" ] || die 'no providers configured; run: codex-provider setup'
    auto_update_models
    for dir in "$ROOT"/*; do
        [ -f "$dir/provider.conf" ] || continue
        dirs+=("${dir##*/}")
    done
    while IFS= read -r h; do homes+=("$h"); done < <(find_legacy_homes)
    items=("${dirs[@]}")
    [ "${#homes[@]}" -gt 0 ] && items+=('=> 恢复 legacy 历史会话 <=')
    [ "${#items[@]}" -gt 0 ] || die 'no providers configured; run: codex-provider setup'
    PS3='Select provider (q to quit): '
    select sel in "${items[@]}"; do
        idx=$((REPLY - 1))
        if [ -n "${sel:-}" ] && [ "$idx" -ge 0 ] && [ "$idx" -lt "${#dirs[@]}" ]; then
            name="${dirs[$idx]}"
            printf 'Updating %s model catalog...\n' "$name"
            update_provider_models "$name" || printf 'codex-provider: using cached model catalog\n' >&2
            choose_model "$(provider_dir "$name")"
            printf '1) resume latest session\n2) start a new session\n'
            read -r -p 'Select session action [1]: ' action
            case "${action:-1}" in
                2) SESSION_SUFFIX="new-$(date +%Y%m%d-%H%M%S)" MODEL_OVERRIDE="$SELECTED_MODEL" run_provider "$name" ;;
                1) MODEL_OVERRIDE="$SELECTED_MODEL" run_provider "$name" resume --last ;;
                *) echo 'Invalid selection.' ;;
            esac
        elif [ -n "${sel:-}" ] && [ "$idx" -eq "${#dirs[@]}" ] && [ "${#homes[@]}" -gt 0 ]; then
            choose_legacy_any
        elif [ "$REPLY" = q ]; then
            exit 0
        else
            echo 'Invalid selection.'
        fi
    done
}

choose_model() {
    local dir="$1" model choice
    local -a models=()
    if [ -f "$dir/model-catalog.json" ] && command -v python3 >/dev/null 2>&1; then
        mapfile -t models < <(python3 - "$dir/model-catalog.json" <<'PY'
import json, sys
try:
    data=json.load(open(sys.argv[1]))
    for item in data.get("models", []):
        value=item.get("slug") or item.get("id")
        if value: print(value)
except Exception:
    pass
PY
)
    fi
    if [ "${#models[@]}" -eq 0 ]; then
        unset name label base_url model wire_api key_env
        . "$dir/provider.conf"
        models=("$model")
    fi
    PS3='Select model (q to quit): '
    select choice in "${models[@]}"; do
        if [ -n "${choice:-}" ]; then
            SELECTED_MODEL="$choice"
            return 0
        elif [ "$REPLY" = q ]; then
            exit 0
        else
            echo 'Invalid selection.'
        fi
    done
}

run_provider() {
    local name="$1"; shift
    local dir="$(provider_dir "$name")"
    [ -f "$dir/provider.conf" ] || die "unknown provider: $name"
    unset name label base_url model wire_api key_env
    . "$dir/provider.conf"
    model="${MODEL_OVERRIDE:-$model}"
    if [ -z "${!key_env:-}" ] && [ -f "$dir/api-key" ]; then
        export "$key_env=$(<"$dir/api-key")"
    fi
    [ -n "${!key_env:-}" ] || die "environment variable $key_env is not set and no saved key exists"
    if [ "${1:-}" = resume ] && [ -z "${SESSION_SUFFIX:-}" ]; then
        local latest_suffix
        latest_suffix="$(newest_dir_under "$dir/sessions/$model")"
        [ -n "$latest_suffix" ] && SESSION_SUFFIX="$latest_suffix"
    fi
    local session_dir="$dir/sessions/$model${SESSION_SUFFIX:+/$SESSION_SUFFIX}"
    mkdir -p "$session_dir"
    chmod 700 "$session_dir"
    export CODEX_HOME="$session_dir"
    export CODEX_PROVIDER_API_KEY="${!key_env}"
    cd "$session_dir"
    local catalog_json=""
    if ensure_codex_catalog "$dir"; then
        catalog_json="$dir/model-catalog-codex.json"
    fi
    cat > "$session_dir/config.toml" <<EOF
$(if [ -n "$catalog_json" ]; then printf 'model_catalog_json = "%s"\n' "$catalog_json"; fi)
model_provider = "$name"
model = "$model"
model_reasoning_effort = "low"

[model_providers.$name]
name = "$label"
base_url = "$base_url"
env_key = "CODEX_PROVIDER_API_KEY"
wire_api = "$wire_api"
$(if [ "$name" = "tokenhub" ]; then printf 'disable_response_storage = true\n'; fi)

[projects."$session_dir"]
trust_level = "trusted"
EOF
    chmod 600 "$session_dir/config.toml"
    command -v tmux >/dev/null 2>&1 || exec "$CODEX" -s danger-full-access "$@"
    local tmux_name="codex-${name}-${model}${SESSION_SUFFIX:+-$SESSION_SUFFIX}"
    # Dots have special meaning in tmux targets (window.pane), so avoid them.
    tmux_name="${tmux_name//[^A-Za-z0-9_-]/-}"
    if [ ! -t 0 ]; then
        exec "$CODEX" -s danger-full-access "$@"
    fi
    if tmux has-session -t "$tmux_name" 2>/dev/null; then
        exec tmux attach-session -t "$tmux_name"
    fi
    local cmdline
    printf -v cmdline '%q ' "$CODEX" -s danger-full-access "$@"
    tmux new-session -d -s "$tmux_name" -c "$session_dir" \
        -e "CODEX_HOME=$session_dir" \
        -e "CODEX_PROVIDER_API_KEY=${CODEX_PROVIDER_API_KEY}" \
        -e "CODEX_PROVIDER_NAME=$name" \
        -e "CODEX_PROVIDER_MODEL=$model" \
        "$cmdline"
    exec tmux attach-session -t "$tmux_name"
}

# ---- legacy codex homes (CODEX_HOMEs not managed by codex-provider) ----
find_legacy_homes() {
    local cand
    local -a candidates=()
    [ -n "${CODEX_HOME:-}" ] && candidates+=("$CODEX_HOME")
    candidates+=("$HOME/.codex")
    for cand in "${candidates[@]}"; do
        case "$cand" in "$ROOT"/*) continue ;; esac
        [ -d "$cand" ] || continue
        [ -d "$cand/sessions" ] || [ -f "$cand/config.toml" ] || continue
        find "$cand/sessions" -name '*.jsonl' 2>/dev/null | grep -q . || continue
        printf '%s\n' "$cand"
    done | sort -u
}

home_provider_model() {
    local home="$1" mp="" model=""
    [ -f "$home/config.toml" ] || { printf 'unknown unknown\n'; return; }
    mp=$(sed -n 's/^model_provider[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$home/config.toml" | head -1)
    model=$(sed -n 's/^model[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$home/config.toml" | head -1)
    printf '%s %s\n' "${mp:-unknown}" "${model:-unknown}"
}

list_home_sessions() {
    local home="$1"
    python3 - "$home" <<'PY'
import json, os, sys
home = sys.argv[1]
base = os.path.join(home, "sessions")
if not os.path.isdir(base):
    sys.exit(0)
rows = []
for root, _dirs, files in os.walk(base):
    for fn in files:
        if not fn.endswith(".jsonl"):
            continue
        p = os.path.join(root, fn)
        try:
            with open(p, encoding="utf-8") as f:
                lines = f.readlines()
            meta = json.loads(lines[0]) if lines else {}
            payload = meta.get("payload", {})
            sid = payload.get("session_id") or payload.get("id") or fn
            ts = payload.get("timestamp", "")
            cwd = payload.get("cwd", "")
            first = ""
            for ln in lines:
                try:
                    obj = json.loads(ln)
                except Exception:
                    continue
                if obj.get("type") == "message" and obj.get("payload", {}).get("role") == "user":
                    content = obj.get("payload", {}).get("content")
                    if isinstance(content, str):
                        first = content
                    elif isinstance(content, list):
                        first = "".join(x.get("text", "") for x in content if isinstance(x, dict) and x.get("type") == "input_text")
                    break
            first = " ".join(first.split())[:60]
            rows.append((os.path.getmtime(p), sid, ts, cwd, first))
        except Exception:
            continue
rows.sort(reverse=True)
for mtime, sid, ts, cwd, first in rows:
    print("%s\t%s\t%s\t%s\t%s" % (mtime, sid, ts, cwd, first))
PY
}

run_legacy_home() {
    local home="$1" sid="$2" mp="" pdir="" envkey="" tag tmux_name cmdline d
    [ -d "$home" ] || die "codex home not found: $home"
    [ -n "$sid" ] || die 'missing session id'
    if [ -f "$home/config.toml" ]; then
        mp=$(sed -n 's/^model_provider[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$home/config.toml" | head -1)
        envkey=$(grep -m1 -oP 'env_key\s*=\s*"\K[^"]+' "$home/config.toml" || true)
    fi
    if [ -n "$envkey" ] && [ -z "${!envkey:-}" ]; then
        if [ -n "$mp" ]; then
            for d in "$ROOT"/*; do
                [ "${d##*/}" = "$mp" ] && pdir="$d"
            done
            [ -z "$pdir" ] && pdir=$(find "$ROOT" -maxdepth 1 -type d -iname "$mp" 2>/dev/null | head -1)
            [ -n "$pdir" ] && [ -f "$pdir/api-key" ] && export "$envkey=$(<"$pdir/api-key")"
        fi
    fi
    if [ -n "$envkey" ] && [ -z "${!envkey:-}" ]; then
        printf 'codex-provider: warning: %s not set; resume may fail auth\n' "$envkey" >&2
    fi
    tag="$(printf '%s' "$home" | sed 's#^/##; s#/#-#g')"
    tmux_name="codex-legacy-${tag//[^A-Za-z0-9_-]/-}"
    cd "$home"
    if [ ! -t 0 ]; then
        exec "$CODEX" -s danger-full-access resume "$sid"
    fi
    if tmux has-session -t "$tmux_name" 2>/dev/null; then
        exec tmux attach-session -t "$tmux_name"
    fi
    printf -v cmdline '%q ' "$CODEX" -s danger-full-access resume "$sid"
    if [ -n "$envkey" ] && [ -n "${!envkey:-}" ]; then
        tmux new-session -d -s "$tmux_name" -c "$home" \
            -e "CODEX_HOME=$home" -e "$envkey=${!envkey}" "$cmdline"
    else
        tmux new-session -d -s "$tmux_name" -c "$home" \
            -e "CODEX_HOME=$home" "$cmdline"
    fi
    exec tmux attach-session -t "$tmux_name"
}

choose_legacy_any() {
    local lgh mtime sid ts cwd first when sel
    local -a homes=() sids=() labels=()
    while IFS= read -r lgh; do
        while IFS=$'\t' read -r mtime sid ts cwd first; do
            when="$(date -d "@${mtime%.*}" '+%m-%d %H:%M' 2>/dev/null || printf '%s' "${mtime%.*}")"
            homes+=("$lgh")
            sids+=("$sid")
            labels+=("$when  ${cwd:-?}  ${first:-}")
        done < <(list_home_sessions "$lgh")
    done < <(find_legacy_homes)
    [ "${#sids[@]}" -gt 0 ] || { echo 'no legacy sessions found'; return 1; }
    PS3='Select legacy session to resume (q to quit): '
    select sel in "${labels[@]}"; do
        if [ -n "${sel:-}" ]; then
            run_legacy_home "${homes[$((REPLY - 1))]}" "${sids[$((REPLY - 1))]}"
        elif [ "$REPLY" = q ]; then
            return 0
        else
            echo 'Invalid selection.'
        fi
    done
}

dir_activity() {
    # Prints the epoch of the newest rollout file under a session dir, falling
    # back to the dir mtime when no rollout exists yet.
    local d="$1" t
    t="$(find "$d/sessions" -type f -name 'rollout-*.jsonl' -printf '%T@\n' 2>/dev/null | sort -nr | head -1)"
    [ -n "$t" ] || t="$(stat -c %Y "$d" 2>/dev/null)"
    printf '%s' "$t"
}

newest_dir_under() {
    # Prints the basename of the most recently active new-* dir under $1.
    local root="$1" d t best=0 out=""
    for d in "$root"/new-*; do
        [ -d "$d" ] || continue
        t="$(dir_activity "$d")"
        [ -n "$t" ] || continue
        t="${t%%.*}"; best="${best%%.*}"
        if [ "$t" -gt "$best" ]; then best="$t"; out="$(basename "$d")"; fi
    done
    printf '%s' "$out"
}

top_sessions() {
    # Prints the $1 most recently active session dirs across all providers as
    # "ACTIVITY PATH" lines, newest first. Activity = newest rollout mtime.
    local count="${1:-3}" d t
    [ -d "$ROOT" ] || return 0
    while IFS= read -r d; do
        t="$(dir_activity "$d")"
        [ -n "$t" ] || continue
        printf '%s %s\n' "$t" "$d"
    done < <(find "$ROOT" -type d -name 'new-*' -path '*/sessions/*' 2>/dev/null) | sort -nr | head -n "$count"
}

go_latest() {
    # Resume the single most recently active session across all providers.
    # Attaches to its tmux if running, otherwise starts it in the background.
    local line act dir name model
    line="$(top_sessions 1)"
    if [ -z "$line" ]; then
        local providers=0 pname=""
        for d in "$ROOT"/*; do
            [ -f "$d/provider.conf" ] || continue
            providers=$((providers + 1))
            pname="${d##*/}"
        done
        if [ "$providers" -eq 1 ]; then
            echo "no previous session found; starting a fresh session with $pname"
            SESSION_SUFFIX="new-$(date +%Y%m%d-%H%M%S)" run_provider "$pname"
            exit $?
        fi
        echo "no previous session found; run 'codex-provider' to pick one" >&2
        exit 1
    fi
    dir="${line#* }"
    name="$(basename "$(dirname "$(dirname "$(dirname "$dir")")")")"
    model="$(basename "$(dirname "$dir")")"
    echo "resuming most recent session: $name / $model / $(basename "$dir")"
    MODEL_OVERRIDE="$model" SESSION_SUFFIX="$(basename "$dir")" run_provider "$name" resume --last
}

pick_recent() {
    local count="${1:-3}" i=0 sel line act act_fmt dir name model start suffix
    local -a dirs=() acts=()
    local -a lg_homes=() lg_sids=() lg_labels=()
    local lgh mtime sid ts cwd first when lg_idx
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        acts+=("${line%% *}")
        dirs+=("${line#* }")
    done < <(top_sessions "$count")
    while IFS= read -r lgh; do
        while IFS=$'\t' read -r mtime sid ts cwd first; do
            when="$(date -d "@${mtime%.*}" '+%m-%d %H:%M' 2>/dev/null || printf '%s' "${mtime%.*}")"
            lg_homes+=("$lgh")
            lg_sids+=("$sid")
            lg_labels+=("$when  ${cwd:-?}  ${first:-}")
        done < <(list_home_sessions "$lgh")
    done < <(find_legacy_homes)
    local total="${#dirs[@]}" lg_total="${#lg_sids[@]}"
    local new_no=$((total + lg_total + 1))
    if [ "$total" -eq 0 ] && [ "$lg_total" -eq 0 ]; then
        echo 'no sessions recorded yet; starting a new session'
        choose_provider
        return 0
    fi
    while true; do
        printf '\n最近 %d 个会话（按最后活跃排序，选编号进入）:\n' "$((total + lg_total))"
        for ((i=0; i<total; i++)); do
            dir="${dirs[$i]}"
            suffix="$(basename "$dir")"
            start="${suffix#new-}"
            if [ "${#start}" -ge 12 ]; then
                start="${start:0:4}-${start:4:2}-${start:6:2} ${start:9:2}:${start:11:2}"
            fi
            name="$(basename "$(dirname "$(dirname "$(dirname "$dir")")")")"
            model="$(basename "$(dirname "$dir")")"
            act="${acts[$i]%%.*}"
            act_fmt='?'
            [ -n "$act" ] && act_fmt="$(date -d "@$act" '+%m-%d %H:%M' 2>/dev/null || echo '?')"
            printf '  %d) 开始 %s · %s/%s · 最后活跃 %s\n' "$((i+1))" "$start" "$name" "$model" "$act_fmt"
            if [ -s "$dir/session_index.jsonl" ] && command -v python3 >/dev/null 2>&1; then
                local title
                title="$(python3 - "$dir/session_index.jsonl" <<'PY'
import json, sys
try:
    rows = [json.loads(l) for l in open(sys.argv[1], encoding='utf-8') if l.strip()]
    print((rows[-1].get('thread_name') or '')[:30] if rows else '')
except Exception:
    print('')
PY
)"
                [ -n "$title" ] && printf '     标题: %s\n' "$title"
            fi
        done
        for ((i=0; i<lg_total; i++)); do
            printf '  %d) %s · legacy %s\n' "$((total + i + 1))" "${lg_labels[$i]}" "${lg_homes[$i]}"
        done
        printf '  %d) 新建会话（选择 provider/模型）\n' "$new_no"
        printf '  q) 退出到 shell\n'
        read -r -p '选择: ' sel || exit 0
        case "$sel" in
            q|Q) exit 0 ;;
            ''|*[!0-9]*) echo '无效输入'; continue ;;
        esac
        if [ "$sel" -ge 1 ] && [ "$sel" -le "$total" ]; then
            dir="${dirs[$((sel-1))]}"
            name="$(basename "$(dirname "$(dirname "$(dirname "$dir")")")")"
            model="$(basename "$(dirname "$dir")")"
            echo "进入会话: $name / $model / $(basename "$dir")"
            MODEL_OVERRIDE="$model" SESSION_SUFFIX="$(basename "$dir")" run_provider "$name" resume --last
            exit $?
        elif [ "$sel" -gt "$total" ] && [ "$sel" -le "$((total + lg_total))" ]; then
            lg_idx=$((sel - total - 1))
            echo "进入 legacy 会话: ${lg_homes[$lg_idx]}"
            run_legacy_home "${lg_homes[$lg_idx]}" "${lg_sids[$lg_idx]}"
            exit $?
        elif [ "$sel" -eq "$new_no" ]; then
            choose_provider
            exit $?
        fi
        echo '无效选择'
    done
}

case "${1:-}" in
    '') choose_provider ;;
    setup) setup_provider ;;
    list) list_providers ;;
    menu) choose_provider ;;
    go) shift; go_latest ;;
    recent) shift; pick_recent "${1:-3}" ;;
    update) [ $# -ge 2 ] || die 'usage: codex-provider update NAME|all'; if [ "$2" = all ]; then for d in "$ROOT"/*; do [ -f "$d/provider.conf" ] || continue; unset name; . "$d/provider.conf"; update_provider_models "$name" || exit 1; done; else update_provider_models "$2"; fi ;;
    use) [ $# -ge 2 ] || die 'usage: codex-provider use NAME [args...]'; name="$2"; shift 2; run_provider "$name" "$@" ;;
    resume) [ $# -ge 2 ] || die 'usage: codex-provider resume NAME [MODEL] [--last|--all|SESSION_ID]'; name="$2"; shift 2; if [ $# -gt 0 ] && [[ "$1" != --* ]]; then MODEL_OVERRIDE="$1"; shift; fi; run_provider "$name" resume "$@" ;;
    *) cat <<'EOF'
Usage:
  codex-provider                 # menu, then resume the selected provider
  codex-provider menu            # same as above
  codex-provider setup
  codex-provider update NAME|all
  codex-provider list
  codex-provider go               # auto-resume the single most recent session
  codex-provider recent [N]       # pick from the N (default 3) most recent sessions
  codex-provider use NAME [codex args...]
  codex-provider resume NAME [MODEL] [--last|--all|SESSION_ID]
EOF
    exit 1 ;;
esac
