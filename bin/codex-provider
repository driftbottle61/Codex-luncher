#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${CODEX_PROVIDER_ROOT:-/root/.codex-providers}"
CODEX="$(command -v codex)"
# codex 0.158 起带后台 app-server daemon，在很深的 CODEX_HOME 下 unix socket 路径会超
# SUN_LEN，必须加 --no-daemon；但 0.158 之前的版本不认识这个参数（会以
# "unexpected argument '--no-daemon'" 直接退出），所以按版本判断，只在新版上追加。
CODEX_NO_DAEMON=""
if [ -n "${CODEX:-}" ]; then
    _codex_ver="$("$CODEX" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true)"
    if [ -n "$_codex_ver" ] && [ "$(printf '%s\n%s\n' "$_codex_ver" 0.158.0 | sort -V | head -n1)" = "0.158.0" ]; then
        CODEX_NO_DAEMON="--no-daemon"
    fi
    unset _codex_ver
fi
# 环境里残留的 MODEL_OVERRIDE / SESSION_SUFFIX（例如从某个 codex tmux 会话继承来的）
# 会悄悄改写本次要进入的模型和会话目录，这里先清掉；本脚本内部调用时会显式传入。
unset MODEL_OVERRIDE SESSION_SUFFIX
die() { printf 'codex-provider: %s\n' "$*" >&2; exit 1; }
valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
provider_dir() { printf '%s/%s' "$ROOT" "$1"; }
conf_value() {
    # provider.conf 是被 bash source 的，含空白/特殊字符的值必须转义后再落盘，
    # 否则下次 source 会把 "label=Alpha Pro" 的 Pro 当命令执行（rc=127）。
    if [[ "$1" =~ ^[A-Za-z0-9_@%+=:,./?-]*$ ]]; then printf '%s' "$1"; else printf '%q' "$1"; fi
}

update_provider_models() {
    # $2 = merge（默认，保留本地已有条目，上游新增的追加在后）/ replace（纯上游列表）
    # name/label/... 必须声明为 local：本函数会重新 source provider.conf，
    # 否则会把调用方（run_provider）刚算好的 $model 覆盖成 provider 的默认模型。
    local pname="$1" mode="${2:-merge}" dir keyvar tmp merged oldjson kept dropped catbak src
    local name label base_url model wire_api key_env group
    dir="$(provider_dir "$pname")"
    [ -f "$dir/provider.conf" ] || die "unknown provider: $pname"
    unset name label base_url model wire_api key_env group
    . "$dir/provider.conf"
    keyvar="$key_env"
    group="${group:-}"
    if [ -z "${!keyvar:-}" ] && [ -f "$dir/api-key" ]; then export "$keyvar=$(<"$dir/api-key")"; fi
    [ -n "${!keyvar:-}" ] || die "environment variable $keyvar is not set and no saved key exists"
    command -v curl >/dev/null 2>&1 || die 'curl is required to update models'
    command -v jq >/dev/null 2>&1 || die 'jq is required to update models'
    tmp="$(mktemp)"; merged="$(mktemp)"
    # 目录来源：优先 new-api 的「分组目录」（/api/pricing 的 enable_groups）。
    # provider.conf 里写了 group= 就用它，没写就自动识别（一次必然失败的请求，不花钱）。
    # /v1/models 只在拿不到分组目录时兜底 —— 它会把别组的模型也报出来。
    src=''
    local ggroup="$group" pricing=''
    if [ -z "$ggroup" ]; then ggroup="$(detect_group "$base_url" "${!keyvar:-}" || true)"; fi
    if [ -n "$ggroup" ]; then
        pricing="$(fetch_pricing "$base_url" "${!keyvar:-}" || true)"
        if printf '%s' "$pricing" | jq -e --arg g "$ggroup" \
             '[.data[] | select((.enable_groups // []) | index($g))] | length > 0' >/dev/null 2>&1; then
            printf '%s' "$pricing" | jq -c --arg g "$ggroup" \
                '{data: [.data[] | select((.enable_groups // []) | index($g)) | {id: .model_name, name: .model_name}]}' > "$tmp"
            src="分组 $ggroup 的目录（/api/pricing）"
        fi
    fi
    if [ -z "$src" ]; then
        if ! curl -fsSL --max-time 30 -H "Authorization: Bearer ${!keyvar}" "$base_url/models" -o "$tmp"; then
            rm -f "$tmp" "$merged"; return 1
        fi
        src='上游 /models'
    fi
    # 合并策略：本地条目按原顺序在前（手工挑选/自建的模型不会被一次刷新抹掉），
    # 上游返回而本地没有的追加在后面。本地目录缺失或损坏则退回纯上游列表。
    oldjson='{"models":[]}'
    if [ "$mode" != replace ] && [ -f "$dir/model-catalog.json" ]; then
        oldjson="$(<"$dir/model-catalog.json")"
    fi
    if ! jq -e --argjson old "$oldjson" '
          def uniqbyid: reduce .[] as $x ([]; if any(.[]; .id == $x.id) then . else . + [$x] end);
          [ (($old.models // [])[]),
            ((.data // .models // [])[] | (.id // .slug) as $id | select($id != null) | {slug:$id,id:$id,display_name:(.name // $id)}) ]
          | uniqbyid | {models: .}
        ' "$tmp" > "$merged" 2>/dev/null; then
        jq -e '{models: [(.data // .models // [])[] | (.id // .slug) as $id | select($id != null) | {slug:$id,id:$id,display_name:(.name // $id)}]}' "$tmp" > "$merged" || { rm -f "$tmp" "$merged"; return 1; }
    fi
    # 上游本次没返回、但本地原有的条目：merge 会保留（提示一下），
    # replace 会丢弃（先备份目录，再把丢掉的列出来）——否则 `update NAME --replace`
    # 会静默清光手工挑选的模型（例如上游清单里不返回但实测可用的 gpt-5.6-luna）。
    kept=''; dropped=''; catbak=''
    if [ -f "$dir/model-catalog.json" ]; then
        dropped="$(jq -r --argjson old "$(<"$dir/model-catalog.json")" '
              [(.data // .models // [])[] | (.id // .slug) | select(. != null)] as $n
              | [($old.models // [])[].id | select(. as $i | ($n | index($i)) == null)] | join(", ")
            ' "$tmp" 2>/dev/null || true)"
    fi
    if [ "$mode" = replace ]; then
        if [ -f "$dir/model-catalog.json" ]; then
            catbak="$dir/model-catalog.json.bak-before-replace-$(date +%Y%m%d-%H%M%S)"
            cp -a "$dir/model-catalog.json" "$catbak"
        fi
    else
        kept="$dropped"; dropped=''
    fi
    # 兜底：空目录会让 codex 直接启动失败（model_catalog_json must contain at least one model）
    if ! jq -e '.models | length > 0' "$merged" >/dev/null 2>&1; then
        rm -f "$tmp" "$merged"
        printf 'codex-provider: 上游返回的模型列表为空，保留现有目录不动\n' >&2
        return 1
    fi
    chmod 600 "$merged"; mv -f "$merged" "$dir/model-catalog.json"; rm -f "$tmp"
    printf 'Updated model catalog: %s（来源: %s）\n' "$dir/model-catalog.json" "$src"
    if [ -n "$kept" ]; then
        printf 'codex-provider: 上游未返回但已保留本地条目: %s（要清掉请用 update %s --replace）\n' "$kept" "$pname" >&2
    fi
    if [ "$mode" = replace ] && [ -n "$dropped" ]; then
        printf 'codex-provider: 警告: --replace 丢弃了上游未返回的本地条目: %s\n' "$dropped" >&2
    fi
    if [ -n "$catbak" ]; then
        printf 'codex-provider: 旧模型目录已备份到 %s（要回退直接覆盖回去即可）\n' "${catbak##*/}" >&2
    fi
    return 0
}

refresh_models_once() {
    # 进入会话前刷新该 provider 的模型列表。$2=1 表示显式刷新（忽略开关）。
    # 失败绝不阻断进入会话；同一 provider 在一次进程里只刷一次。
    local pname="$1" force="${2:-0}"
    if [ "$force" != 1 ] && [ "${CODEX_PROVIDER_REFRESH_ON_SESSION:-1}" != 1 ]; then return 0; fi
    case " ${MODELS_REFRESHED:-} " in *" $pname "*) return 0 ;; esac
    MODELS_REFRESHED="${MODELS_REFRESHED:-} $pname"
    printf '刷新 %s 的模型列表...\n' "$pname"
    update_provider_models "$pname" || printf 'codex-provider: 模型列表刷新失败（网络或密钥问题），继续用本地缓存\n' >&2
    return 0
}

auto_update_models() {
    local dir
    [ "${CODEX_PROVIDER_AUTO_UPDATE:-0}" = 1 ] || return 0
    for dir in "$ROOT"/*; do [ -f "$dir/provider.conf" ] || continue; unset name; . "$dir/provider.conf"; update_provider_models "$name" || true; done
}

ensure_base_instructions() {
    local out="$ROOT/base-instructions.md" ver tag url
    [ -s "$out" ] && { printf '%s' "$out"; return 0; }
    ver="$(codex --version 2>/dev/null | sed -n 's/^codex-cli \([0-9][0-9.]*\).*/\1/p' | head -1 || true)"
    tag="main"
    [ -n "$ver" ] && tag="rust-v$ver"
    command -v curl >/dev/null 2>&1 || { printf '%s' ''; return 0; }
    url="https://raw.githubusercontent.com/openai/codex/$tag/codex-rs/models-manager/prompt.md"
    if curl -fsSL --max-time 20 "$url" -o "$out.tmp" 2>/dev/null && [ -s "$out.tmp" ]; then
        mv "$out.tmp" "$out"; chmod 644 "$out"; printf '%s' "$out"; return 0
    fi
    rm -f "$out.tmp"
    if [ "$tag" != main ]; then
        url="https://raw.githubusercontent.com/openai/codex/main/codex-rs/models-manager/prompt.md"
        if curl -fsSL --max-time 20 "$url" -o "$out.tmp" 2>/dev/null && [ -s "$out.tmp" ]; then
            mv "$out.tmp" "$out"; chmod 644 "$out"; printf '%s' "$out"; return 0
        fi
        rm -f "$out.tmp"
    fi
    printf '%s' ''
}

ensure_codex_catalog() {
    local dir="$1" base
    [ -f "$dir/model-catalog.json" ] || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    base="$(ensure_base_instructions)"
    python3 - "$dir" "${base:-}" <<'PY'
import json, os, sys
dirpath, base_path = sys.argv[1], sys.argv[2] or None
src = json.load(open(os.path.join(dirpath, "model-catalog.json")))
instructions = "You are a helpful coding assistant."
if base_path and os.path.isfile(base_path):
    with open(base_path, encoding="utf-8") as f:
        content = f.read().strip()
    if content:
        instructions = content
models = []
for item in src.get("models", []):
    slug = item.get("slug") or item.get("id")
    if not slug:
        continue
    models.append({
        "slug": slug,
        "display_name": item.get("display_name") or slug,
        "description": item.get("description"),
        "default_reasoning_level": "low",
        "supported_reasoning_levels": [
            {"effort": "low", "description": "Fast responses with lighter reasoning"},
            {"effort": "medium", "description": "Balances speed and reasoning depth for everyday tasks"},
            {"effort": "high", "description": "Greater reasoning depth for complex problems"},
        ],
        "shell_type": "unified_exec",
        "visibility": "list",
        "supported_in_api": True,
        "priority": 10,
        "availability_nux": None,
        "upgrade": None,
        "default_reasoning_summary": "auto",
        "support_verbosity": False,
        "default_verbosity": None,
        "apply_patch_tool_type": None,
        "web_search_tool_type": "text",
        "truncation_policy": {"mode": "tokens", "limit": 10000},
        "supports_image_detail_original": False,
        "context_window": 272000,
        "max_context_window": 272000,
        "auto_compact_token_limit": None,
        "comp_hash": None,
        "effective_context_window_percent": 95,
        "experimental_supported_tools": [],
        "input_modalities": ["text"],
        "supports_search_tool": False,
        "use_responses_lite": False,
        "node_repl_auto_review_required": False,
        "node_repl_disabled": False,
        "auto_review_model_override": None,
        "model_specialty": None,
        "tool_mode": None,
        "multi_agent_version": None,
        "multi_agent_reasoning_effort": None,
        "model_messages": {
            "persistent_instructions": None,
            "tools": None,
            "instructions_template": instructions,
            "instructions_variables": None,
            "approvals": None,
            "collaboration_modes": None,
            "auto_review": None,
            "permissions": None,
            "multi_agent": None,
            "token_budget": None,
            "confirmation_policies": None,
            "guardian_v2": None,
        },
    })
if not models:
    sys.exit(1)
out = os.path.join(dirpath, "model-catalog-codex.json")
tmp = out + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump({"models": models}, f, indent=2, ensure_ascii=False)
os.replace(tmp, out)
os.chmod(out, 0o600)
PY
}

setup_provider() {
    local name label base model wire keyvar key catalog group dir
    read -r -p 'Provider name: ' name
    valid_name "$name" || die 'invalid provider name'
    dir="$(provider_dir "$name")"
    read -r -p "Display name [$name]: " label; label="${label:-$name}"
    read -r -p 'API base URL: ' base
    [[ "$base" =~ ^https?:// ]] || die 'API base URL must start with http:// or https://'
    read -r -p 'Model: ' model; [ -n "$model" ] || die 'model is required'
    read -r -p 'Wire API [responses]: ' wire; wire="${wire:-responses}"
    read -r -p 'Model catalog JSON path or URL (optional): ' catalog
    read -r -p 'Relay group (optional, e.g. AZ; Enter = auto-detect): ' group
    read -r -p 'API key environment variable [OPENAI_API_KEY]: ' keyvar; keyvar="${keyvar:-OPENAI_API_KEY}"
    [[ "$keyvar" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die 'invalid environment variable name'
    read -r -s -p 'API key (hidden input): ' key; printf '\n'
    [ -n "$key" ] || die 'API key is required'
    mkdir -p "$dir/sessions"; chmod 700 "$ROOT" "$dir" "$dir/sessions"
    cat > "$dir/provider.conf" <<EOF
name=$(conf_value "$name")
label=$(conf_value "$label")
base_url=$(conf_value "$base")
model=$(conf_value "$model")
wire_api=$(conf_value "$wire")
key_env=$(conf_value "$keyvar")
group=$(conf_value "$group")
EOF
    chmod 600 "$dir/provider.conf"
    printf '%s\n' "$key" > "$dir/api-key"
    chmod 600 "$dir/api-key"
    if [ -n "$catalog" ]; then
        case "$catalog" in
            https://*|http://*) command -v curl >/dev/null 2>&1 || die 'curl is required for catalog URL'; curl -fsSL --max-time 30 "$catalog" -o "$dir/model-catalog.json" ;;
            *) [ -f "$catalog" ] || die "catalog file not found: $catalog"; cp "$catalog" "$dir/model-catalog.json" ;;
        esac
        chmod 600 "$dir/model-catalog.json"
    fi
    printf 'Configured %s. Export %s before use.\n' "$name" "$keyvar"
}

edit_provider() {
    # 修改已有 provider：交互模式逐项回车 = 保持原值，--set field=value 走非交互。
    # 只改写 provider.conf 的既有字段（注释/未知行原样保留），改前自动备份 .bak-before-edit-<时间戳>。
    local pname='' do_refresh=0
    local -a sets=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --refresh) do_refresh=1; shift ;;
            --set) [ $# -ge 2 ] || die 'edit: --set needs field=value'; sets+=("$2"); shift 2 ;;
            --set=*) sets+=("${1#--set=}"); shift ;;
            --*) die "edit: unknown option: $1" ;;
            *) if [ -z "$pname" ]; then pname="$1"; else die "edit: unexpected argument: $1"; fi; shift ;;
        esac
    done
    [ -n "$pname" ] || die 'usage: codex-provider edit NAME [--set field=value]... [--refresh]'
    local dir; dir="$(provider_dir "$pname")"
    [ -f "$dir/provider.conf" ] || die "unknown provider: $pname"

    # 读当前值作默认值（provider.conf 不含密钥，key 单独放 api-key）
    local name label base_url model wire_api key_env group
    unset name label base_url model wire_api key_env group
    . "$dir/provider.conf"
    label="${label:-}"; base_url="${base_url:-}"; model="${model:-}"
    wire_api="${wire_api:-}"; key_env="${key_env:-}"; group="${group:-}"

    local new_label="$label" new_base="$base_url" new_model="$model"
    local new_wire="$wire_api" new_keyenv="$key_env" new_group="$group" new_key='' key_changed=0
    local new_strip="${strip_reasoning:-}"
    local kv f v ans
    if [ "${#sets[@]}" -gt 0 ]; then
        for kv in "${sets[@]}"; do
            f="${kv%%=*}"; v="${kv#*=}"
            [ "$f" != "$kv" ] || die "edit: --set expects field=value, got: $kv"
            case "$f" in
                label) new_label="$v" ;;
                base_url|base-url|baseurl) new_base="$v" ;;
                group) new_group="$v" ;;
                strip_reasoning|strip-reasoning|strip) new_strip="$v" ;;
                model) new_model="$v" ;;
                wire_api|wire-api|wire) new_wire="$v" ;;
                key_env|key-env|keyenv) new_keyenv="$v" ;;
                key|api_key|api-key) new_key="$v"; key_changed=1 ;;
                *) die "edit: unknown field: $f (label|base_url|group|model|wire_api|key_env|key|strip_reasoning)" ;;
            esac
        done
    fi

    if [ "${#sets[@]}" -eq 0 ]; then
        [ -t 0 ] || die 'edit: 非交互调用请用 --set field=value，例如 codex-provider edit NAME --set model=xxx'
        printf '编辑 %s（直接回车 = 保持原值）\n' "$pname"
        read -r -p "Display name [$new_label]: " ans; new_label="${ans:-$new_label}"
        read -r -p "API base URL [$new_base]: " ans; new_base="${ans:-$new_base}"
        read -r -p "Model [$new_model]: " ans; new_model="${ans:-$new_model}"
        read -r -p "Relay group (empty = 自动识别) [$new_group]: " ans; new_group="${ans:-$new_group}"
        read -r -p "进会话前自动摘除解不开的 encrypted reasoning？(1/0) [${new_strip:-0}]: " ans; new_strip="${ans:-$new_strip}"
        read -r -p "Wire API [$new_wire]: " ans; new_wire="${ans:-$new_wire}"
        read -r -p "API key environment variable [$new_keyenv]: " ans; new_keyenv="${ans:-$new_keyenv}"
        read -r -s -p 'API key (留空 = 不修改): ' ans; printf '\n'
        if [ -n "$ans" ]; then new_key="$ans"; key_changed=1; fi
    fi

    [ -n "$new_label" ] || die 'edit: display name 不能为空'
    [[ "$new_base" =~ ^https?:// ]] || die 'edit: API base URL must start with http:// or https://'
    [ -n "$new_model" ] || die 'edit: model 不能为空'
    [ -n "$new_wire" ] || die 'edit: wire api 不能为空'
    if [[ "$new_base" =~ [[:space:]] || "$new_model" =~ [[:space:]] || "$new_wire" =~ [[:space:]] ]]; then
        die 'edit: base_url / model / wire_api 不能包含空白字符'
    fi
    [[ "$new_keyenv" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die 'edit: invalid environment variable name'
    case "${new_strip:-}" in ''|0|1) ;; *) die 'edit: strip_reasoning 只能是 1 或 0（空 = 关闭）' ;; esac
    if [ "$key_changed" = 1 ] && [ -z "$new_key" ]; then die 'edit: API key 不能为空'; fi

    if [ "$new_label" = "$label" ] && [ "$new_base" = "$base_url" ] && [ "$new_model" = "$model" ] \
       && [ "$new_wire" = "$wire_api" ] && [ "$new_keyenv" = "$key_env" ] && [ "$new_group" = "$group" ] \
       && [ "${new_strip:-}" = "${strip_reasoning:-}" ] \
       && [ "$key_changed" = 0 ]; then
        printf '%s: 未做任何修改。\n' "$pname"
        return 0
    fi

    local ts backup tmp line seen=''
    ts="$(date +%Y%m%d-%H%M%S)"
    backup="$dir/provider.conf.bak-before-edit-$ts"
    cp -a "$dir/provider.conf" "$backup"
    tmp="$(mktemp)"
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            label=*) printf 'label=%s\n' "$(conf_value "$new_label")" >> "$tmp"; seen="$seen label" ;;
            base_url=*) printf 'base_url=%s\n' "$(conf_value "$new_base")" >> "$tmp"; seen="$seen base_url" ;;
            model=*) printf 'model=%s\n' "$(conf_value "$new_model")" >> "$tmp"; seen="$seen model" ;;
            wire_api=*) printf 'wire_api=%s\n' "$(conf_value "$new_wire")" >> "$tmp"; seen="$seen wire_api" ;;
            key_env=*) printf 'key_env=%s\n' "$(conf_value "$new_keyenv")" >> "$tmp"; seen="$seen key_env" ;;
            group=*) printf 'group=%s\n' "$(conf_value "$new_group")" >> "$tmp"; seen="$seen group" ;;
            strip_reasoning=*) [ -n "${new_strip:-}" ] && printf 'strip_reasoning=%s\n' "$(conf_value "$new_strip")" >> "$tmp"; seen="$seen strip_reasoning" ;;
            *) printf '%s\n' "$line" >> "$tmp" ;;
        esac
    done < "$dir/provider.conf"
    case " $seen " in *' label '*) ;; *) printf 'label=%s\n' "$(conf_value "$new_label")" >> "$tmp" ;; esac
    case " $seen " in *' base_url '*) ;; *) printf 'base_url=%s\n' "$(conf_value "$new_base")" >> "$tmp" ;; esac
    case " $seen " in *' model '*) ;; *) printf 'model=%s\n' "$(conf_value "$new_model")" >> "$tmp" ;; esac
    case " $seen " in *' wire_api '*) ;; *) printf 'wire_api=%s\n' "$(conf_value "$new_wire")" >> "$tmp" ;; esac
    case " $seen " in *' key_env '*) ;; *) printf 'key_env=%s\n' "$(conf_value "$new_keyenv")" >> "$tmp" ;; esac
    case " $seen " in *' group '*) ;; *) printf 'group=%s\n' "$(conf_value "$new_group")" >> "$tmp" ;; esac
    if [ -n "${new_strip:-}" ]; then case " $seen " in *' strip_reasoning '*) ;; *) printf 'strip_reasoning=%s\n' "$(conf_value "$new_strip")" >> "$tmp" ;; esac; fi
    grep -q '^name=' "$tmp" || printf 'name=%s\n' "$(conf_value "$pname")" >> "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$dir/provider.conf"

    if [ "$key_changed" = 1 ]; then
        if [ -f "$dir/api-key" ]; then cp -a "$dir/api-key" "$dir/api-key.bak-before-edit-$ts"; fi
        printf '%s\n' "$new_key" > "$dir/api-key"
        chmod 600 "$dir/api-key"
        printf 'api-key 已更新（%s 字符），旧 key 备份在 api-key.bak-before-edit-%s\n' "${#new_key}" "$ts"
    fi

    printf '\n--- diff (备份 %s) ---\n' "${backup##*/}"
    diff -u --label "${backup##*/}" --label 'provider.conf (new)' "$backup" "$dir/provider.conf" || true
    printf '\n%s 现在的配置：\n' "$pname"
    printf '  label=%s\n  base_url=%s\n  group=%s\n  model=%s\n  wire_api=%s\n  key_env=%s%s\n' \
        "$new_label" "$new_base" "${new_group:-（未设置，自动识别）}" "$new_model" "$new_wire" "$new_keyenv" "${new_strip:+  strip_reasoning=$new_strip}"

    if [ "$do_refresh" = 1 ]; then
        printf '\n刷新模型列表...\n'
        update_provider_models "$pname" || printf 'codex-provider: 模型列表刷新失败，本地缓存保持不变\n' >&2
    elif [ "$new_base" != "$base_url" ]; then
        printf '\n提示: base_url 已变更，接着跑 `codex-provider update %s`（默认 merge，保留本地条目）或加 --refresh 刷新模型列表。\n' "$pname"
    fi
    return 0
}

pricing_url() {
    # new-api 类中转的目录接口：base_url 去掉尾部 /v1 再拼 /api/pricing
    local b="${1%/}"; b="${b%/v1}"; printf '%s/api/pricing' "$b"
}

fetch_pricing() {
    # $1=base_url $2=key（可空）。打印 /api/pricing 的 JSON；取不到返回 1
    command -v curl >/dev/null 2>&1 || return 1
    curl -fsSL --max-time 30 -H "Authorization: Bearer ${2:-}" "$(pricing_url "$1")" 2>/dev/null
}

detect_group() {
    # token 所属分组：用一个必然不存在的模型发一次请求，new-api 会在 503 里回
    # "No available channel for model X under group AZ"。一定失败 ⇒ 不花额度。
    local resp
    resp="$(curl -s --max-time 30 -X POST "${1%/}/responses" \
        -H "Authorization: Bearer ${2:-}" -H 'Content-Type: application/json' \
        -d '{"model":"__codex_provider_group_probe__","input":"hi","max_output_tokens":16,"stream":false}' 2>/dev/null || true)"
    printf '%s' "$resp" | sed -n 's/.*[Uu]nder group \([^ )]*\).*/\1/p' | head -1
}

groups_provider() {
    # 列出中转的分组目录（new-api 的 /api/pricing → enable_groups），并标出本 token 的分组
    local pname='' only_group=''
    while [ $# -gt 0 ]; do
        case "$1" in
            --group) [ $# -ge 2 ] || die 'groups: --group needs a name'; only_group="$2"; shift 2 ;;
            --group=*) only_group="${1#--group=}"; shift ;;
            --*) die "groups: unknown option: $1" ;;
            *) if [ -z "$pname" ]; then pname="$1"; else die "groups: unexpected argument: $1"; fi; shift ;;
        esac
    done
    [ -n "$pname" ] || die 'usage: codex-provider groups NAME [--group G]'
    local dir; dir="$(provider_dir "$pname")"
    [ -f "$dir/provider.conf" ] || die "unknown provider: $pname"
    local name label base_url model wire_api key_env
    unset name label base_url model wire_api key_env
    . "$dir/provider.conf"
    base_url="${base_url:-}"; key_env="${key_env:-}"
    if [ -z "${!key_env:-}" ] && [ -f "$dir/api-key" ]; then export "$key_env=$(<"$dir/api-key")"; fi
    local pricing
    pricing="$(fetch_pricing "$base_url" "${!key_env:-}")" || pricing=''
    printf '%s' "$pricing" | jq -e '.data' >/dev/null 2>&1 || die "groups: 取不到 $(pricing_url "$base_url") 的目录（该中转可能不是 new-api 型）"
    if [ -n "$only_group" ]; then
        local n
        n="$(printf '%s' "$pricing" | jq -r --arg g "$only_group" '[.data[] | select((.enable_groups // []) | index($g))] | length')"
        [ "$n" -gt 0 ] || die "groups: 没有分组 $only_group（先跑 codex-provider groups $pname 看全部）"
        printf '分组 %s 的模型（%d 个）:\n' "$only_group" "$n"
        printf '%s' "$pricing" | jq -r --arg g "$only_group" \
            '.data[] | select((.enable_groups // []) | index($g)) | "  \(.model_name)\t\((.supported_endpoint_types // []) | join(","))"'
        return 0
    fi
    local mine
    mine="$(detect_group "$base_url" "${!key_env:-}")"
    printf '所有分组（按模型数排序）:\n'
    printf '%s' "$pricing" | jq -r '[.data[].enable_groups[]?] | group_by(.) | map({g: .[0], n: length}) | sort_by(-.n) | .[] | "  \(.n)\t\(.g)"'
    if [ -n "$mine" ]; then
        printf '\n本 token 所属分组: %s\n  看它的目录: codex-provider groups %s --group %s\n' "$mine" "$pname" "$mine"
    else
        printf '\n未能自动识别本 token 的分组；probe 时用 --group 指定。\n'
    fi
    return 0
}

probe_provider() {
    # 候选来源（优先级）：--model > --group > 自动识别的 token 分组 > 本地目录 ∪ 上游 /models。
    # 前三者来自 new-api 的 /api/pricing（enable_groups 是权威的分组目录），
    # 不用一个一个去猜；探测只是用来区分「目录里有」和「现在真有渠道」。
    local pname='' apply=0 assume_yes=0 jobs=4 timeout=60 wide=0 no_verify=0 group=''
    local -a only=() keep=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --apply) apply=1; shift ;;
            --yes|-y) assume_yes=1; shift ;;
            --wide) wide=1; shift ;;
            --no-verify) no_verify=1; shift ;;
            --group) [ $# -ge 2 ] || die 'probe: --group needs a name'; group="$2"; shift 2 ;;
            --group=*) group="${1#--group=}"; shift ;;
            --jobs) [ $# -ge 2 ] || die 'probe: --jobs needs a number'; jobs="$2"; shift 2 ;;
            --jobs=*) jobs="${1#--jobs=}"; shift ;;
            --timeout) [ $# -ge 2 ] || die 'probe: --timeout needs seconds'; timeout="$2"; shift 2 ;;
            --timeout=*) timeout="${1#--timeout=}"; shift ;;
            --model) [ $# -ge 2 ] || die 'probe: --model needs an id'; only+=("$2"); shift 2 ;;
            --model=*) only+=("${1#--model=}"); shift ;;
            --keep) [ $# -ge 2 ] || die 'probe: --keep needs an id'; keep+=("$2"); shift 2 ;;
            --keep=*) keep+=("${1#--keep=}"); shift ;;
            --*) die "probe: unknown option: $1" ;;
            *) if [ -z "$pname" ]; then pname="$1"; else die "probe: unexpected argument: $1"; fi; shift ;;
        esac
    done
    [ -n "$pname" ] || die 'usage: codex-provider probe NAME [--group G] [--model M]... [--keep M]... [--apply] [--no-verify] [--wide] [--jobs N] [--timeout S] [--yes]'
    [[ "$jobs" =~ ^[1-9][0-9]*$ ]] || die 'probe: --jobs must be a positive integer'
    [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || die 'probe: --timeout must be a positive integer'
    local dir; dir="$(provider_dir "$pname")"
    [ -f "$dir/provider.conf" ] || die "unknown provider: $pname"
    local name label base_url model wire_api key_env group_conf opt_group="$group"
    unset name label base_url model wire_api key_env group_conf
    . "$dir/provider.conf"
    group_conf="${group:-}"; group="$opt_group"
    base_url="${base_url:-}"; model="${model:-}"; wire_api="${wire_api:-responses}"; key_env="${key_env:-}"
    [ -n "$base_url" ] || die 'probe: provider.conf 里没有 base_url'
    if [ -z "${!key_env:-}" ] && [ -f "$dir/api-key" ]; then export "$key_env=$(<"$dir/api-key")"; fi
    [ -n "${!key_env:-}" ] || die "environment variable $key_env is not set and no saved key exists"
    command -v curl >/dev/null 2>&1 || die 'curl is required to probe models'
    command -v jq >/dev/null 2>&1 || die 'jq is required to probe models'

    local -a cands=()
    local listf tmp m src=''
    if [ "${#only[@]}" -gt 0 ]; then
        cands=("${only[@]}"); src='--model 指定'
    else
        local pricing='' grp="${group:-$group_conf}"
        if [ "$wide" != 1 ]; then
            pricing="$(fetch_pricing "$base_url" "${!key_env:-}" || true)"
            if printf '%s' "$pricing" | jq -e '.data' >/dev/null 2>&1; then
                if [ -z "$grp" ]; then
                    grp="$(detect_group "$base_url" "${!key_env:-}")"
                    if [ -n "$grp" ]; then printf 'codex-provider: 检测到本 token 所属分组: %s\n' "$grp" >&2; fi
                fi
            else
                pricing=''
                if [ -n "$grp" ]; then printf 'codex-provider: 取不到 /api/pricing，--group 用不上\n' >&2; fi
            fi
        fi
        if [ -n "$grp" ] && [ -n "$pricing" ]; then
            mapfile -t cands < <(printf '%s' "$pricing" | jq -r --arg g "$grp" \
                '.data[] | select((.enable_groups // []) | index($g)) | .model_name')
            [ "${#cands[@]}" -gt 0 ] || die "probe: 分组 $grp 在 /api/pricing 里没有任何模型（用 codex-provider groups $pname 看全部分组）"
            src="分组 $grp 的目录（/api/pricing）"
        fi
        if [ "${#cands[@]}" -eq 0 ]; then
            listf="$(mktemp)"; tmp="$(mktemp)"
            if [ -f "$dir/model-catalog.json" ]; then
                jq -r '.models[]? | (.slug // .id) | select(. != null)' "$dir/model-catalog.json" 2>/dev/null >> "$listf" || true
            fi
            if curl -fsSL --max-time 30 -H "Authorization: Bearer ${!key_env:-}" "$base_url/models" -o "$tmp" 2>/dev/null; then
                jq -r '(.data // .models // [])[] | (.id // .slug) | select(. != null)' "$tmp" 2>/dev/null >> "$listf" || true
            else
                printf 'codex-provider: 上游 /models 取不到，候选只用本地目录\n' >&2
            fi
            rm -f "$tmp"
            [ -s "$listf" ] || printf '%s\n' "$model" >> "$listf"
            mapfile -t cands < <(awk 'NF && !seen[$0]++' "$listf")
            rm -f "$listf"
            src='本地目录 ∪ 上游 /models（没有分组信息；用 --group 或 provider.conf 的 group= 可以只取某个分组）'
        fi
    fi
    for m in "${cands[@]}"; do
        if [[ "$m" =~ [[:space:]] ]]; then die "probe: 模型 id 不能含空白字符: $m"; fi
    done
    [ "${#cands[@]}" -gt 0 ] || die 'probe: 没有候选模型'
    printf '候选来源: %s\n' "$src"

    local helper outdir okf slot st code detail ans nok=0 nbad=0
    helper="$(mktemp)"; outdir="$(mktemp -d)"; okf="$(mktemp)"

    if [ "$no_verify" = 1 ]; then
        printf '采用 %d 个模型（--no-verify，不发探测请求、不花额度）:\n' "${#cands[@]}"
        for m in "${cands[@]}"; do printf '  %s\n' "$m"; done
        printf '%s\n' "${cands[@]}" > "$okf"
        nok=${#cands[@]}
        rmdir "$outdir" 2>/dev/null || rm -rf "$outdir"
        rm -f "$helper"
    else
        printf '将探测 %s 的 %d 个模型（每个一次最小请求：input=hi / max_output_tokens=16）\n' "$pname" "${#cands[@]}"
        if [ "$assume_yes" != 1 ]; then
            [ -t 0 ] || die 'probe: 非交互调用请加 --yes（探测会产生极少量 API 费用）'
            read -r -p '继续？[y/N] ' ans
            case "$ans" in y|Y|yes|YES) ;; *) printf '已取消。\n'; return 0 ;; esac
        fi
        cat > "$helper" <<'HELPER'
#!/usr/bin/env bash
set -uo pipefail
m="$1"
slot="$OUTDIR/$(printf '%s' "$m" | md5sum | cut -c1-32)"
body="$(mktemp)"
if [ "$WIRE" = chat ]; then
    url="$BASE/chat/completions"
    payload="$(printf '{"model":"%s","messages":[{"role":"user","content":"hi"}],"max_tokens":16,"stream":false}' "$m")"
else
    url="$BASE/responses"
    payload="$(printf '{"model":"%s","input":"hi","max_output_tokens":16,"stream":false}' "$m")"
fi
code="$(curl -s -o "$body" -w '%{http_code}' --max-time "$TIMEOUT" -X POST "$url" \
        -H "Authorization: Bearer $KEY" -H 'Content-Type: application/json' -d "$payload" 2>/dev/null)" || code=000
ok=false
if [ "$code" = 200 ]; then
    if [ "$WIRE" = chat ]; then
        if [ "$(jq -r 'has("choices") and (.error == null)' "$body" 2>/dev/null)" = true ]; then ok=true; fi
    else
        if [ "$(jq -r '(.status // "completed") == "completed" and (.error == null)' "$body" 2>/dev/null)" = true ]; then ok=true; fi
    fi
fi
detail="$(jq -r '.error.message // empty' "$body" 2>/dev/null | tr '\n\r\t' '   ' | cut -c1-100)"
printf '%s\t%s\t%s\n' "$ok" "$code" "$detail" > "$slot"
rm -f "$body"
HELPER
        chmod 700 "$helper"
        export WIRE="$wire_api" BASE="$base_url" KEY="${!key_env:-}" TIMEOUT="$timeout" OUTDIR="$outdir"
        printf '%s\n' "${cands[@]}" | xargs -r -P "$jobs" -n 1 "$helper" || true
        unset WIRE BASE KEY TIMEOUT OUTDIR
        for m in "${cands[@]}"; do
            slot="$outdir/$(printf '%s' "$m" | md5sum | cut -c1-32)"
            if [ -f "$slot" ]; then IFS=$'\t' read -r st code detail < "$slot" || true; else st=false; code=000; detail='探测未返回结果'; fi
            if [ "$st" = true ]; then
                printf '  [可用] %-42s http=%s\n' "$m" "$code"
                printf '%s\n' "$m" >> "$okf"
                nok=$((nok + 1))
            else
                printf '  [不可用] %-40s http=%s %s\n' "$m" "$code" "$detail"
                nbad=$((nbad + 1))
            fi
        done
        rm -rf "$outdir" "$helper"
        printf '\n可用 %d 个，不可用 %d 个\n' "$nok" "$nbad"
    fi

    if [ "$apply" != 1 ]; then
        printf '模型列表未改动；要按上面这份结果重建就加 --apply。\n'
        rm -f "$okf"
        return 0
    fi
    local k
    for k in ${keep[@]+"${keep[@]}"}; do printf '%s\n' "$k" >> "$okf"; done
    local newcat n
    newcat="$(mktemp)"
    n="$(python3 - "$dir/model-catalog.json" "$okf" "$newcat" <<'PY'
import json, os, sys
cat_path, ok_path, out_path = sys.argv[1], sys.argv[2], sys.argv[3]
ok = [l.strip() for l in open(ok_path, encoding="utf-8") if l.strip()]
seen = set(ok)
order = []
if os.path.exists(cat_path):
    try:
        for item in json.load(open(cat_path, encoding="utf-8")).get("models", []):
            value = item.get("slug") or item.get("id")
            if value and value in seen and value not in order:
                order.append(value)
    except Exception:
        pass
for value in ok:
    if value not in order:
        order.append(value)
with open(out_path, "w", encoding="utf-8") as f:
    json.dump({"models": [{"slug": i, "id": i, "display_name": i} for i in order]},
              f, indent=2, ensure_ascii=False)
os.chmod(out_path, 0o600)
print(len(order))
PY
)" || { rm -f "$newcat" "$okf"; die 'probe: 生成新模型目录失败'; }
    if ! [[ "$n" =~ ^[0-9]+$ ]] || [ "$n" -le 0 ]; then
        rm -f "$newcat" "$okf"
        die 'probe: 结果为空，保留原目录不动'
    fi
    if [ -n "$model" ] && ! grep -qxF "$model" "$okf"; then
        printf 'codex-provider: 提示: provider.conf 的默认模型 %s 不在这次的结果里，建议改掉（codex-provider edit %s --set model=...）\n' "$model" "$pname" >&2
    fi
    local bak="$dir/model-catalog.json.bak-before-probe-$(date +%Y%m%d-%H%M%S)"
    if [ -f "$dir/model-catalog.json" ]; then cp -a "$dir/model-catalog.json" "$bak"; fi
    chmod 600 "$newcat"
    mv -f "$newcat" "$dir/model-catalog.json"
    rm -f "$okf"
    printf '模型列表已重建: %s 项（%s）\n' "$n" "$dir/model-catalog.json"
    if [ -f "$bak" ]; then printf '旧目录备份: %s（要回退直接覆盖回去即可）\n' "${bak##*/}"; fi
    ensure_codex_catalog "$dir" >/dev/null 2>&1 || true
    return 0
}

list_providers() {
    [ -d "$ROOT" ] || { echo 'No providers configured.'; return; }
    for dir in "$ROOT"/*; do
        local name label base_url model wire_api key_env group
        [ -f "$dir/provider.conf" ] || continue
        unset name label base_url model wire_api key_env group
        . "$dir/provider.conf"
        printf '%-18s model=%-28s key=%s sessions=%s%s\n' "$name" "$model" "$key_env" "$dir/sessions" "${group:+ group=$group}"
    done
}

choose_provider() {
    local dir name sel h idx action
    local -a dirs=() items=() homes=()
    if [ -d "$ROOT" ]; then
        auto_update_models
        for dir in "$ROOT"/*; do
            [ -f "$dir/provider.conf" ] || continue
            dirs+=("${dir##*/}")
        done
    fi
    while IFS= read -r h; do homes+=("$h"); done < <(find_legacy_homes)
    items=("${dirs[@]}")
    [ "${#homes[@]}" -gt 0 ] && items+=('=> 恢复 legacy 历史会话 <=')
    if [ "${#items[@]}" -eq 0 ]; then
        printf '\ncodex-provider: 未检测到任何 provider 或历史会话——首次使用，先添加一个 provider。\n'
        printf '（Ctrl-C 可退出；添加完成后会自动回到菜单）\n'
        setup_provider
        choose_provider
        return 0
    fi
    PS3='Select provider (q to quit): '
    select sel in "${items[@]}"; do
        if [[ "$REPLY" =~ ^[0-9]+$ ]]; then
            idx=$((REPLY - 1))
            if [ "$idx" -ge 0 ] && [ "$idx" -lt "${#dirs[@]}" ]; then
                name="${dirs[$idx]}"
                refresh_models_once "$name" 1
                choose_model "$(provider_dir "$name")"
                printf '1) resume latest session\n2) start a new session\n'
                read -r -p 'Select session action [1]: ' action
                case "${action:-1}" in
                    2) SESSION_SUFFIX="new-$(date +%Y%m%d-%H%M%S)" MODEL_OVERRIDE="$SELECTED_MODEL" run_provider "$name" ;;
                    1) MODEL_OVERRIDE="$SELECTED_MODEL" run_provider "$name" resume --last ;;
                    *) echo 'Invalid selection.' ;;
                esac
            elif [ "$idx" -eq "${#dirs[@]}" ] && [ "${#homes[@]}" -gt 0 ]; then
                choose_legacy_any
            else
                echo 'Invalid selection.'
            fi
        elif [ "$REPLY" = q ]; then
            exit 0
        else
            echo 'Invalid selection.'
        fi
    done
}

choose_model() {
    local dir="$1" model choice
    local -a models=()
    if [ -f "$dir/model-catalog.json" ] && command -v python3 >/dev/null 2>&1; then
        mapfile -t models < <(python3 - "$dir/model-catalog.json" <<'PY'
import json, sys
try:
    data=json.load(open(sys.argv[1]))
    for item in data.get("models", []):
        value=item.get("slug") or item.get("id")
        if value: print(value)
except Exception:
    pass
PY
)
    fi
    if [ "${#models[@]}" -eq 0 ]; then
        unset name label base_url model wire_api key_env
        . "$dir/provider.conf"
        models=("$model")
    fi
    PS3='Select model (q to quit): '
    select choice in "${models[@]}"; do
        if [ -n "${choice:-}" ]; then
            SELECTED_MODEL="$choice"
            return 0
        elif [ "$REPLY" = q ]; then
            exit 0
        else
            echo 'Invalid selection.'
        fi
    done
}

run_provider() {
    local name="$1"; shift
    local dir="$(provider_dir "$name")" pname="$name"
    local label base_url model wire_api key_env strip_reasoning
    [ -f "$dir/provider.conf" ] || die "unknown provider: $name"
    label=""; base_url=""; model=""; wire_api=""; key_env=""; strip_reasoning=""
    . "$dir/provider.conf"
    model="${MODEL_OVERRIDE:-$model}"
    if [ -z "${!key_env:-}" ] && [ -f "$dir/api-key" ]; then
        export "$key_env=$(<"$dir/api-key")"
    fi
    [ -n "${!key_env:-}" ] || die "environment variable $key_env is not set and no saved key exists"
    refresh_models_once "$pname"
    # refresh_models_once 会重新读 provider.conf；万一它动了 $model，这里把
    # 用户/菜单选定的模型再确认一次，免得会话被写进 provider 默认模型的目录。
    model="${MODEL_OVERRIDE:-$model}"
    if [ "${1:-}" = resume ] && [ -z "${SESSION_SUFFIX:-}" ]; then
        local latest_suffix
        latest_suffix="$(newest_dir_under "$dir/sessions/$model")"
        [ -n "$latest_suffix" ] && SESSION_SUFFIX="$latest_suffix"
    fi
    local session_dir="$dir/sessions/$model${SESSION_SUFFIX:+/$SESSION_SUFFIX}"
    mkdir -p "$session_dir"
    chmod 700 "$session_dir"
    if [ "${strip_reasoning:-}" = 1 ] && [ -n "${SESSION_SUFFIX:-}" ]; then
        local -a rollouts=() strip_out=''
        while IFS= read -r f; do rollouts+=("$f"); done < <(find "$session_dir" -name '.*' -prune -o -name 'rollout-*.jsonl' -print 2>/dev/null)
        if [ "${#rollouts[@]}" -gt 0 ]; then
            strip_out="$(reasoning_strip apply-first-only "${rollouts[@]}")"
            case "$strip_out" in
                *'item(s)'*) printf 'codex-provider: 已摘除 %s 处上游解不开的 encrypted reasoning item（历史消息保留）\n' \
                    "$(printf '%s' "$strip_out" | sed -n 's/.*SUMMARY \([0-9]*\) \([0-9]*\).*/\2/p')" >&2 ;;
            esac
        fi
    fi
    export CODEX_HOME="$session_dir"
    export CODEX_PROVIDER_API_KEY="${!key_env}"
    cd "$session_dir"
    local catalog_json=""
    if ensure_codex_catalog "$dir"; then
        catalog_json="$dir/model-catalog-codex.json"
    fi
    cat > "$session_dir/config.toml" <<EOF
$(if [ -n "$catalog_json" ]; then printf 'model_catalog_json = "%s"\n' "$catalog_json"; fi)
model_provider = "$name"
model = "$model"
model_reasoning_effort = "low"

[model_providers.$name]
name = "$label"
base_url = "$base_url"
env_key = "CODEX_PROVIDER_API_KEY"
wire_api = "$wire_api"
# 中转基本都跑在共享配额上（实测 openmove/AZ = Azure japaneast 的 token rate limit，
# 几分钟后自己恢复）。codex 默认只重试几次，这里放宽，让它自己熬过 429/503 的短窗口，
# 并把上游的 Retry-After 用上；真正的故障仍会照常报错。
request_max_retries = 8
stream_max_retries = 8
$(if [ "$name" = "tokenhub" ]; then printf 'disable_response_storage = true\n'; fi)

[projects."$session_dir"]
trust_level = "trusted"
EOF
    chmod 600 "$session_dir/config.toml"
    command -v tmux >/dev/null 2>&1 || exec "$CODEX" -s danger-full-access $CODEX_NO_DAEMON "$@"
    local tmux_name="codex-${name}-${model}${SESSION_SUFFIX:+-$SESSION_SUFFIX}"
    # Dots have special meaning in tmux targets (window.pane), so avoid them.
    tmux_name="${tmux_name//[^A-Za-z0-9_-]/-}"
    if [ ! -t 0 ]; then
        exec "$CODEX" -s danger-full-access $CODEX_NO_DAEMON "$@"
    fi
    local cmdline
    printf -v cmdline '%q ' "$CODEX" -s danger-full-access $CODEX_NO_DAEMON "$@"
    if tmux has-session -t "$tmux_name" 2>/dev/null; then
        if tmux_env_stale "$tmux_name" CODEX_PROVIDER_API_KEY "$CODEX_PROVIDER_API_KEY"; then
            printf 'codex-provider: %s 的凭证已更新，正在带新凭证重启会话（历史保留）...\n' "$name" >&2
            printf 'codex-provider: 若该会话报 invalid_encrypted_content，可用 codex-provider repair %s 修复历史\n' "$name" >&2
            tmux set-environment -t "$tmux_name" CODEX_PROVIDER_API_KEY "$CODEX_PROVIDER_API_KEY"
            tmux respawn-pane -k -t "$tmux_name" -c "$session_dir" \
                -e "CODEX_HOME=$session_dir" \
                -e "CODEX_PROVIDER_API_KEY=$CODEX_PROVIDER_API_KEY" \
                -e "CODEX_PROVIDER_NAME=$name" \
                -e "CODEX_PROVIDER_MODEL=$model" \
                "$cmdline"
        fi
        exec tmux attach-session -t "$tmux_name"
    fi
    tmux new-session -d -s "$tmux_name" -c "$session_dir" \
        -e "CODEX_HOME=$session_dir" \
        -e "CODEX_PROVIDER_API_KEY=${CODEX_PROVIDER_API_KEY}" \
        -e "CODEX_PROVIDER_NAME=$name" \
        -e "CODEX_PROVIDER_MODEL=$model" \
        "$cmdline"
    exec tmux attach-session -t "$tmux_name"
}

reasoning_strip() {  # reasoning_strip scan|apply|apply-first-only FILES...
    # 上游对 reasoning item 的 encrypted_content 是按账号加密的：换 key/分组后老 item 解不开，
    # 偶尔也会有单个 item 变成解不开（实测：同一批里只有某一个 400，其余 200），
    # 而 codex 每次回放都要原样发回去 ⇒ 一个坏 item 就能让整个会话永久报
    # invalid_encrypted_content。reasoning item 对回放不是必需的，所以这里把它摘掉，
    # 消息 / 工具调用 / 命令输出一律不动。
    # scan            只报告，不写盘
    # apply           备份（总有时间戳）后写入
    # apply-first-only 只在还没有备份时才备份（自动模式用，避免备份文件堆积）
    python3 - "$@" <<'PY'
import glob, json, os, shutil, sys, time
mode = sys.argv[1]
files = sys.argv[2:]
stamp = time.strftime('%Y%m%d-%H%M%S')
nfiles = nitems = 0
for path in files:
    try:
        with open(path, encoding='utf-8') as fh:
            lines = fh.readlines()
    except OSError:
        continue
    keep = []
    drops = 0
    for line in lines:
        if 'encrypted_content' in line:
            try:
                rec = json.loads(line)
            except Exception:
                rec = None
            if rec and rec.get('type') == 'response_item':
                payload = rec.get('payload') or {}
                if payload.get('type') == 'reasoning' and payload.get('encrypted_content'):
                    drops += 1
                    continue
        keep.append(line)
    if not drops:
        continue
    nfiles += 1
    nitems += drops
    print('  %d item(s)  %s' % (drops, path))
    if mode == 'scan':
        continue
    if mode == 'apply' or not glob.glob(path + '.bak-before-repair-*'):
        bak = '%s.bak-before-repair-%s' % (path, stamp)
        seq = 1
        while os.path.exists(bak):
            seq += 1
            bak = '%s.bak-before-repair-%s-%d' % (path, stamp, seq)
        shutil.copy2(path, bak)
    tmp = path + '.new'
    with open(tmp, 'w', encoding='utf-8') as fh:
        fh.writelines(keep)
    os.replace(tmp, path)
print('SUMMARY %d %d' % (nfiles, nitems))
PY
}

repair_provider() {
    # 见 reasoning_strip 的注释：把上游解不开的 encrypted reasoning item 从会话历史里摘掉。
    local pname='' only_model='' assume_yes=0 apply=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --model) [ $# -ge 2 ] || die 'repair: --model needs a name'; only_model="$2"; shift 2 ;;
            --model=*) only_model="${1#--model=}"; shift ;;
            --yes|-y) assume_yes=1; shift ;;
            --apply) apply=1; shift ;;
            -*) die "repair: unknown option: $1" ;;
            *) [ -z "$pname" ] || die "repair: unexpected argument: $1"; pname="$1"; shift ;;
        esac
    done
    [ -n "$pname" ] || die 'usage: codex-provider repair NAME [--model M] [--yes] [--apply]'
    local dir; dir="$(provider_dir "$pname")"
    [ -f "$dir/provider.conf" ] || die "unknown provider: $pname"
    if [ ! -d "$dir/sessions" ]; then
        printf 'repair: %s 还没有会话历史（%s/sessions 不存在）\n' "$pname" "$dir"
        return 0
    fi
    command -v python3 >/dev/null 2>&1 || die 'python3 is required to repair session history'
    local -a files=() hits=()
    # 点开头的目录（.tmp、手工备份的 .history-backup-* 等）不是会话，别扫进去
    while IFS= read -r f; do files+=("$f"); done < <(find "$dir/sessions" -name '.*' -prune -o -name 'rollout-*.jsonl' -print 2>/dev/null | sort)
    if [ -n "$only_model" ]; then
        for f in "${files[@]}"; do case "$f" in *"/$only_model/"*) hits+=("$f") ;; esac; done
    else
        hits=("${files[@]}")
    fi
    if [ "${#hits[@]}" -eq 0 ]; then
        printf 'repair: %s 下面没有找到 rollout 文件（%s/sessions%s）\n' "$pname" "$dir" "${only_model:+，model $only_model}"
        return 0
    fi

    local summary nfiles nitems
    summary="$(reasoning_strip scan "${hits[@]}")"
    printf '%s\n' "$summary" | grep -v '^SUMMARY ' | grep -v '^$' || true
    nfiles="$(printf '%s' "$summary" | sed -n 's/.*SUMMARY \([0-9]*\) \([0-9]*\).*/\1/p')"
    nitems="$(printf '%s' "$summary" | sed -n 's/.*SUMMARY \([0-9]*\) \([0-9]*\).*/\2/p')"
    nfiles="${nfiles:-0}"; nitems="${nitems:-0}"
    if [ "$nitems" -eq 0 ]; then
        printf 'repair: %s 的会话历史没有需要处理的 encrypted reasoning item\n' "$pname"
        return 0
    fi
    printf 'repair: %s 共 %s 个文件、%s 个 reasoning item 含加密内容\n' "$pname" "$nfiles" "$nitems"
    if [ "$apply" != 1 ] && [ "$assume_yes" != 1 ]; then
        if [ ! -t 0 ]; then
            printf 'repair: 需要确认（用 --yes 跳过交互）\n' >&2
            return 1
        fi
        local ans
        read -r -p '要摘掉这些 reasoning item 吗？（原文件会先备份）[y/N]: ' ans
        case "${ans:-n}" in y|Y) ;; *) printf 'repair: 已取消\n'; return 1 ;; esac
    fi
    reasoning_strip apply "${hits[@]}" >/dev/null
    printf 'repair: 完成（备份后缀 .bak-before-repair-<时间戳>，就在原文件旁边）\n'
}

# ---- tmux session environment staleness -----------------------------------
# tmux 里已经跑着的进程不会被 set-environment 影响：会话建好之后 provider 换了
# api-key（或 key 环境变量改名），attach 上去的老进程还在用旧凭证，表现就是上游
# 回 "No available channel" 之类莫名其妙的 503。这里在 attach 前比对一次，
# 不一致就带新环境 respawn 掉这个 pane（codex 的会话历史在磁盘上，不丢）。
tmux_env_value() {  # tmux_env_value SESSION NAME
    tmux show-environment -t "$1" "$2" 2>/dev/null | sed -n "s/^$2=//p"
}

proc_env_value() {  # proc_env_value SESSION NAME  (读 pane 里实际进程的环境)
    local pid
    pid="$(tmux list-panes -t "$1" -F '#{pane_pid}' 2>/dev/null | head -1)"
    [ -n "$pid" ] && [ -r "/proc/$pid/environ" ] || return 0
    tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n "s/^$2=//p" | head -1
}

tmux_env_stale() {  # tmux_env_stale SESSION NAME WANT -> 0 表示需要刷新
    local cur
    [ -n "${3:-}" ] || return 1
    cur="$(tmux_env_value "$1" "$2")"
    [ -n "$cur" ] && [ "$cur" != "$3" ] && return 0
    cur="$(proc_env_value "$1" "$2")"
    [ -n "$cur" ] && [ "$cur" != "$3" ] && return 0
    return 1
}

# ---- legacy codex homes (CODEX_HOMEs not managed by codex-provider) ----
find_legacy_homes() {
    local cand
    local -a candidates=()
    [ -n "${CODEX_HOME:-}" ] && candidates+=("$CODEX_HOME")
    candidates+=("$HOME/.codex")
    for cand in "${candidates[@]}"; do
        case "$cand" in "$ROOT"/*) continue ;; esac
        [ -d "$cand" ] || continue
        [ -d "$cand/sessions" ] || [ -f "$cand/config.toml" ] || continue
        find "$cand/sessions" -name '*.jsonl' 2>/dev/null | grep -q . || continue
        printf '%s\n' "$cand"
    done | sort -u
}

home_provider_model() {
    local home="$1" mp="" model=""
    [ -f "$home/config.toml" ] || { printf 'unknown unknown\n'; return; }
    mp=$(sed -n 's/^model_provider[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$home/config.toml" | head -1)
    model=$(sed -n 's/^model[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$home/config.toml" | head -1)
    printf '%s %s\n' "${mp:-unknown}" "${model:-unknown}"
}

list_home_sessions() {
    local home="$1"
    python3 - "$home" <<'PY'
import json, os, sys
home = sys.argv[1]
base = os.path.join(home, "sessions")
if not os.path.isdir(base):
    sys.exit(0)
rows = []
for root, _dirs, files in os.walk(base):
    for fn in files:
        if not fn.endswith(".jsonl"):
            continue
        p = os.path.join(root, fn)
        try:
            with open(p, encoding="utf-8") as f:
                lines = f.readlines()
            meta = json.loads(lines[0]) if lines else {}
            payload = meta.get("payload", {})
            sid = payload.get("session_id") or payload.get("id") or fn
            ts = payload.get("timestamp", "")
            cwd = payload.get("cwd", "")
            first = ""
            for ln in lines:
                try:
                    obj = json.loads(ln)
                except Exception:
                    continue
                if obj.get("type") == "message" and obj.get("payload", {}).get("role") == "user":
                    content = obj.get("payload", {}).get("content")
                    if isinstance(content, str):
                        first = content
                    elif isinstance(content, list):
                        first = "".join(x.get("text", "") for x in content if isinstance(x, dict) and x.get("type") == "input_text")
                    break
            first = " ".join(first.split())[:60]
            rows.append((os.path.getmtime(p), sid, ts, cwd, first))
        except Exception:
            continue
rows.sort(reverse=True)
for mtime, sid, ts, cwd, first in rows:
    print("%s\t%s\t%s\t%s\t%s" % (mtime, sid, ts, cwd, first))
PY
}

run_legacy_home() {
    local home="$1" sid="$2" mp="" pdir="" envkey="" tag tmux_name cmdline d
    [ -d "$home" ] || die "codex home not found: $home"
    [ -n "$sid" ] || die 'missing session id'
    if [ -f "$home/config.toml" ]; then
        mp=$(sed -n 's/^model_provider[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$home/config.toml" | head -1)
        envkey=$(grep -m1 -oP 'env_key\s*=\s*"\K[^"]+' "$home/config.toml" || true)
    fi
    if [ -n "$envkey" ] && [ -z "${!envkey:-}" ]; then
        if [ -n "$mp" ]; then
            for d in "$ROOT"/*; do
                [ "${d##*/}" = "$mp" ] && pdir="$d"
            done
            [ -z "$pdir" ] && pdir=$(find "$ROOT" -maxdepth 1 -type d -iname "$mp" 2>/dev/null | head -1)
            [ -n "$pdir" ] && [ -f "$pdir/api-key" ] && export "$envkey=$(<"$pdir/api-key")"
        fi
    fi
    if [ -n "$envkey" ] && [ -z "${!envkey:-}" ]; then
        printf 'codex-provider: warning: %s not set; resume may fail auth\n' "$envkey" >&2
    fi
    tag="$(printf '%s' "$home" | sed 's#^/##; s#/#-#g')"
    tmux_name="codex-legacy-${tag//[^A-Za-z0-9_-]/-}-${sid//[^A-Za-z0-9_-]/-}"
    cd "$home"
    if [ ! -t 0 ]; then
        exec "$CODEX" -s danger-full-access $CODEX_NO_DAEMON resume "$sid"
    fi
    printf -v cmdline '%q ' "$CODEX" -s danger-full-access $CODEX_NO_DAEMON resume "$sid"
    if tmux has-session -t "$tmux_name" 2>/dev/null; then
        if [ -n "$envkey" ] && tmux_env_stale "$tmux_name" "$envkey" "${!envkey:-}"; then
            printf 'codex-provider: %s 已更新，正在带新凭证重启会话（历史保留）...\n' "$envkey" >&2
            tmux set-environment -t "$tmux_name" "$envkey" "${!envkey}"
            tmux respawn-pane -k -t "$tmux_name" -c "$home" -e "CODEX_HOME=$home" -e "$envkey=${!envkey}" "$cmdline"
        fi
        exec tmux attach-session -t "$tmux_name"
    fi
    if [ -n "$envkey" ] && [ -n "${!envkey:-}" ]; then
        tmux new-session -d -s "$tmux_name" -c "$home" \
            -e "CODEX_HOME=$home" -e "$envkey=${!envkey}" "$cmdline"
    else
        tmux new-session -d -s "$tmux_name" -c "$home" \
            -e "CODEX_HOME=$home" "$cmdline"
    fi
    exec tmux attach-session -t "$tmux_name"
}

choose_legacy_any() {
    local lgh mtime sid ts cwd first when sel
    local -a homes=() sids=() labels=()
    while IFS= read -r lgh; do
        while IFS=$'\t' read -r mtime sid ts cwd first; do
            when="$(date -d "@${mtime%.*}" '+%m-%d %H:%M' 2>/dev/null || printf '%s' "${mtime%.*}")"
            homes+=("$lgh")
            sids+=("$sid")
            labels+=("$when  ${cwd:-?}  ${first:-}")
        done < <(list_home_sessions "$lgh")
    done < <(find_legacy_homes)
    [ "${#sids[@]}" -gt 0 ] || { echo 'no legacy sessions found'; return 1; }
    PS3='Select legacy session to resume (q to quit): '
    select sel in "${labels[@]}"; do
        if [ -n "${sel:-}" ]; then
            run_legacy_home "${homes[$((REPLY - 1))]}" "${sids[$((REPLY - 1))]}"
        elif [ "$REPLY" = q ]; then
            return 0
        else
            echo 'Invalid selection.'
        fi
    done
}

dir_activity() {
    # Prints the epoch of the newest HOME-LOCAL activity in a session dir.
    # Do NOT trust rollout mtime as the primary signal: threads.rollout_path is
    # absolute and can point OUTSIDE this home (that is what happens when a
    # home gets copied to another model dir), so a busy dir would rank on a
    # file it does not own. history.jsonl / state_5.sqlite(-wal) / config.toml
    # are only ever written by the home that is actually running (config.toml
    # is rewritten by run_provider on every launch), so use those first; the
    # local rollout and the dir mtime remain as fallbacks.
    local d="$1" t best=0 f
    for f in "$d/history.jsonl" "$d/state_5.sqlite" "$d/state_5.sqlite-wal" "$d/config.toml"; do
        # 0 字节的 WAL = 没有未落盘的内容，它的 mtime 只会被「打开过这个库」
        # 这类无关操作碰新（判断脚本、备份工具……），不能当作会话活跃度。
        case "$f" in
            *-wal) [ -s "$f" ] || continue ;;
        esac
        t="$(stat -c %Y "$f" 2>/dev/null || true)"
        [ -n "$t" ] || continue
        [ "$t" -gt "$best" ] && best="$t"
    done
    if [ "$best" -eq 0 ]; then
        t="$(find "$d/sessions" -type f -name 'rollout-*.jsonl' -printf '%T@\n' 2>/dev/null | sort -nr | head -1)"
        [ -n "$t" ] && best="${t%%.*}"
    fi
    [ "$best" -eq 0 ] && best="$(stat -c %Y "$d" 2>/dev/null)"
    printf '%s' "$best"
}

newest_dir_under() {
    # Prints the basename of the most recently active new-* dir under $1.
    local root="$1" d t best=0 out=""
    for d in "$root"/new-*; do
        [ -d "$d" ] || continue
        t="$(dir_activity "$d")"
        [ -n "$t" ] || continue
        t="${t%%.*}"; best="${best%%.*}"
        if [ "$t" -gt "$best" ]; then best="$t"; out="$(basename "$d")"; fi
    done
    printf '%s' "$out"
}

catalog_sessions() {
    # One session record per line, newest activity first, across managed
    # providers and legacy homes:
    #   m<TAB>epoch<TAB>session_dir                     (managed)
    #   l<TAB>epoch<TAB>home<TAB>sid<TAB>cwd<TAB>first   (legacy)
    local d t lgh mtime sid ts cwd first
    while IFS= read -r d; do
        t="$(dir_activity "$d")"
        [ -n "$t" ] || continue
        printf 'm\t%s\t%s\n' "${t%%.*}" "$d"
    done < <(find "$ROOT" -type d -name 'new-*' -path '*/sessions/*' 2>/dev/null)
    while IFS= read -r lgh; do
        while IFS=$'\t' read -r mtime sid ts cwd first; do
            printf 'l\t%s\t%s\t%s\t%s\t%s\n' "${mtime%.*}" "$lgh" "$sid" "$cwd" "$first"
        done < <(list_home_sessions "$lgh")
    done < <(find_legacy_homes)
}

go_latest() {
    # Auto-resume the single most recently active session, managed or legacy.
    local line kind act rest dir name model home sid cwd first
    line="$(catalog_sessions | sort -t$'\t' -k2,2nr | head -1)"
    if [ -z "$line" ]; then
        local providers=0 pname=""
        for d in "$ROOT"/*; do
            [ -f "$d/provider.conf" ] || continue
            providers=$((providers + 1))
            pname="${d##*/}"
        done
        if [ "$providers" -eq 1 ]; then
            echo "no previous session found; starting a fresh session with $pname"
            SESSION_SUFFIX="new-$(date +%Y%m%d-%H%M%S)" run_provider "$pname"
            exit $?
        fi
        echo "no previous session found; run 'codex-provider' to pick one" >&2
        exit 1
    fi
    kind="${line%%$'\t'*}"
    rest="${line#*$'\t'}"
    if [ "$kind" = l ]; then
        IFS=$'\t' read -r act home sid cwd first <<<"$rest"
        echo "resuming most recent session: legacy $(basename "$home") / ${sid%.jsonl}"
        run_legacy_home "$home" "$sid"
        exit $?
    fi
    IFS=$'\t' read -r act dir <<<"$rest"
    name="$(basename "$(dirname "$(dirname "$(dirname "$dir")")")")"
    model="$(basename "$(dirname "$dir")")"
    echo "resuming most recent session: $name / $model / $(basename "$dir")"
    MODEL_OVERRIDE="$model" SESSION_SUFFIX="$(basename "$dir")" run_provider "$name" resume --last
}

pick_recent() {
    # Menu over the most recent sessions (managed + legacy), merged and sorted
    # by real activity so the truly newest session is always entry #1.
    local count="${1:-10}" i=0 sel=0 line kind act rest total=0
    local -a kinds=() dirs=() homes=() sids=() labels=() subs=()
    local m_n=0 l_n=0 dir name model suffix start act_fmt title
    local home sid cwd first when
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        kind="${line%%$'\t'*}"
        rest="${line#*$'\t'}"
        if [ "$kind" = m ]; then
            [ "$m_n" -lt "$count" ] || continue
            IFS=$'\t' read -r act dir <<<"$rest"
            m_n=$((m_n + 1))
            suffix="$(basename "$dir")"
            start="${suffix#new-}"
            if [ "${#start}" -ge 12 ]; then
                start="${start:0:4}-${start:4:2}-${start:6:2} ${start:9:2}:${start:11:2}"
            fi
            name="$(basename "$(dirname "$(dirname "$(dirname "$dir")")")")"
            model="$(basename "$(dirname "$dir")")"
            act_fmt='?'
            [ -n "$act" ] && act_fmt="$(date -d "@$act" '+%m-%d %H:%M' 2>/dev/null || echo '?')"
            kinds+=(m); dirs+=("$dir"); homes+=(''); sids+=('')
            labels+=("开始 $start · $name/$model · 最后活跃 $act_fmt")
            title=''
            if [ -s "$dir/session_index.jsonl" ] && command -v python3 >/dev/null 2>&1; then
                title="$(python3 - "$dir/session_index.jsonl" <<'PY'
import json, sys
try:
    rows = [json.loads(l) for l in open(sys.argv[1], encoding='utf-8') if l.strip()]
    print((rows[-1].get('thread_name') or '')[:30] if rows else '')
except Exception:
    print('')
PY
)"
            fi
            subs+=("$title")
        else
            [ "$l_n" -lt "$count" ] || continue
            IFS=$'\t' read -r act home sid cwd first <<<"$rest"
            l_n=$((l_n + 1))
            when="$(date -d "@$act" '+%m-%d %H:%M' 2>/dev/null || printf '%s' "$act")"
            kinds+=(l); dirs+=(''); homes+=("$home"); sids+=("$sid")
            labels+=("$when  ${cwd:-?}  ${first:-} · legacy $home")
            subs+=('')
        fi
    done < <(catalog_sessions | sort -t$'\t' -k2,2nr)
    total="${#kinds[@]}"
    local new_no=$((total + 1))
    if [ "$total" -eq 0 ]; then
        printf '\n还没有可恢复的会话。'
        choose_provider
        return 0
    fi
    while true; do
        printf '\n最近 %d 个会话（按最后活跃排序，选编号进入）:\n' "$total"
        for ((i=0; i<total; i++)); do
            printf '  %d) %s\n' "$((i+1))" "${labels[$i]}"
            if [ -n "${subs[$i]}" ]; then printf '     标题: %s\n' "${subs[$i]}"; fi
        done
        printf '  %d) 新建会话（选择 provider/模型）\n' "$new_no"
        printf '  q) 退出到 shell\n'
        read -r -p '选择: ' sel || exit 0
        case "$sel" in
            q|Q) exit 0 ;;
            ''|*[!0-9]*) echo '无效输入'; continue ;;
        esac
        if [ "$sel" -ge 1 ] && [ "$sel" -le "$total" ]; then
            i=$((sel - 1))
            if [ "${kinds[$i]}" = m ]; then
                dir="${dirs[$i]}"
                name="$(basename "$(dirname "$(dirname "$(dirname "$dir")")")")"
                model="$(basename "$(dirname "$dir")")"
                echo "进入会话: $name / $model / $(basename "$dir")"
                MODEL_OVERRIDE="$model" SESSION_SUFFIX="$(basename "$dir")" run_provider "$name" resume --last
            else
                echo "进入 legacy 会话: ${sids[$i]} @ ${homes[$i]}"
                run_legacy_home "${homes[$i]}" "${sids[$i]}"
            fi
            exit $?
        elif [ "$sel" -eq "$new_no" ]; then
            choose_provider
            exit $?
        else
            echo '无效选择'
        fi
    done
}

case "${1:-}" in
    '') choose_provider ;;
    setup) setup_provider ;;
    edit) shift; edit_provider "$@" ;;
    probe) shift; probe_provider "$@" ;;
    repair) shift; repair_provider "$@" ;;
    groups) shift; groups_provider "$@" ;;
    list) list_providers ;;
    menu) choose_provider ;;
    go) shift; go_latest ;;
    recent) shift; pick_recent "${1:-10}" ;;
    update)
        shift
        update_mode=merge; update_target=''
        for a in "$@"; do
            case "$a" in
                --replace) update_mode=replace ;;
                --*) die "unknown option: $a" ;;
                *) if [ -z "$update_target" ]; then update_target="$a"; fi ;;
            esac
        done
        [ -n "$update_target" ] || die 'usage: codex-provider update NAME|all [--replace]'
        if [ "$update_target" = all ]; then
            for d in "$ROOT"/*; do
                [ -f "$d/provider.conf" ] || continue
                unset name; . "$d/provider.conf"
                update_provider_models "$name" "$update_mode" || exit 1
            done
        else
            update_provider_models "$update_target" "$update_mode"
        fi ;;
    use) [ $# -ge 2 ] || die 'usage: codex-provider use NAME [args...]'; name="$2"; shift 2; run_provider "$name" "$@" ;;
    resume) [ $# -ge 2 ] || die 'usage: codex-provider resume NAME [MODEL] [--last|--all|SESSION_ID]'; name="$2"; shift 2; if [ $# -gt 0 ] && [[ "$1" != --* ]]; then MODEL_OVERRIDE="$1"; shift; fi; run_provider "$name" resume "$@" ;;
    *) cat <<'EOF'
Usage:
  codex-provider                 # menu, then resume the selected provider
  codex-provider menu            # same as above
  codex-provider setup
  codex-provider update NAME|all [--replace]
                                       # refresh model catalog (default: merge, keep local-only entries)
  codex-provider edit NAME [--set field=value]... [--refresh]
                                       # edit an existing provider; empty answer keeps
                                       # the current value. --set is non-interactive
                                       # (fields: label base_url group model wire_api key_env key)
  codex-provider groups NAME [--group G]
                                       # list the relay's groups (new-api /api/pricing)
  codex-provider repair NAME [--model M] [--yes]
                                       # 摘掉会话历史里上游无法解密的 encrypted
                                       # reasoning item（换 key/分组后老会话会报
                                       # invalid_encrypted_content）；原文件先备份
  codex-provider probe NAME [--group G] [--model M]... [--keep M]...
                           [--apply] [--no-verify] [--wide] [--jobs N]
                                       # candidates come from the token's group catalog
                                       # (/api/pricing enable_groups, auto-detected);
                                       # each is tested with a minimal real request
                                       # --no-verify skips the requests, --apply writes
  codex-provider list
  codex-provider go               # auto-resume the single most recent session
  codex-provider recent [N]       # pick from the N (default 10) most recent sessions
  codex-provider use NAME [codex args...]
  codex-provider resume NAME [MODEL] [--last|--all|SESSION_ID]
EOF
    exit 1 ;;
esac
